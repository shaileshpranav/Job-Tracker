# Everything here is optional — provider, model, keys and Ollama host can all be
# set in the app's ⚙ Settings, which overrides this file.
# ---- Provider: anthropic (default) | openrouter | ollama
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Ollama — local; default host shown
# OLLAMA_HOST=http://localhost:11434

PORT=4321
# DATA_DIR=./data  APPLICATIONS_DIR=./applications  PROFILE_DIR=./profile   # move storage elsewhere (e.g. a synced folder)
# JOB_CONCURRENCY=1   # background tasks run one at a time; raise to 2-3 if you only use hosted models
# HOST=127.0.0.1   # default 0.0.0.0 = reachable from your phone on the same Wi-Fi; set this to keep it local-only

# AUTH_PASSWORD=choose-a-password   # optional; require this password to open the app (also settable from ⚙ Settings → Security).
                                      # Strongly recommended if you leave HOST at its 0.0.0.0 default — otherwise anyone on your Wi-Fi can open it.
